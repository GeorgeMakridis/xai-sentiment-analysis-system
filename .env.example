# ═══════════════════════════════════════════════════════════════════════
# XAI Sentiment Analysis System — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ── OpenAI (for RAG chat) ────────────────────────────────────────────
OPENAI_API_KEY=

# ── RustFS (remote S3-compatible object storage) ─────────────────────
# EXTRA-BRAIN project RustFS instance
# Console: https://rustfs.extra-brain.unparallel.pt
RESTFS_ENDPOINT=rustfs.extra-brain.unparallel.pt
RESTFS_ACCESS_KEY=your-access-key-here
RESTFS_SECRET_KEY=your-secret-key-here
RESTFS_SECURE=true

# Bucket names (auto-created on first use)
# RESTFS_BUCKET_PLOTS=xai-plots
# RESTFS_BUCKET_DATASETS=xai-datasets
# RESTFS_BUCKET_METADATA=xai-metadata

# ── Authentication ───────────────────────────────────────────────────
# AUTH_MODE=legacy         — dev mode: dict-based users (default)
# AUTH_MODE=keycloak       — production: Keycloak OIDC
AUTH_MODE=legacy

# Flask session secret (change in production!)
FLASK_SECRET_KEY=change-me-in-production

# Legacy mode credentials (only used when AUTH_MODE=legacy)
LEGACY_ADMIN_PW=changeme
LEGACY_ANALYST_PW=changeme

# ── Keycloak (only needed when AUTH_MODE=keycloak) ───────────────────
# Start with:  docker compose --profile keycloak up -d
KC_SERVER_URL=http://keycloak:8080
KC_EXTERNAL_URL=http://localhost:8080
KC_REALM=xai-platform
KC_CLIENT_ID=xai-dashboard
KC_CLIENT_SECRET=
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_DB_PASSWORD=keycloak

# HTTPS / reverse proxy (dashboard): use https in production, or rely on
# X-Forwarded-Proto when the ingress forwards it (ProxyFix in dashboard).
PREFERRED_URL_SCHEME=http
# Optional: public origin of the dashboard if the proxy does not send trusted
# forwarded headers (must match Keycloak Valid redirect URIs).
# PUBLIC_BASE_URL=https://xai-sentiment-analysis-system.example.com

# ── External AI Service Adapter (optional) ───────────────────────────
# Set to the base URL of your AI model service to replace the built-in mock.
# The service must implement:  POST /predict,  POST /explain,  GET /model-info
AI_ADAPTER_URL=
AI_ADAPTER_TIMEOUT=60

# ── Service URLs (override for non-Docker or custom networking) ──────
XAI_SERVICE_URL=http://xai_service:8000
AI_OUTPUTS_SERVICE_URL=http://ai_outputs:8001

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
