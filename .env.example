# OpenAI API Key (required for AI Assistant features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Optional: Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: File size limits
MAX_FILE_SIZE=10485760
REQUEST_TIMEOUT=30

# Optional: RestFS (RustFS) - used when RustFS is available
# RESTFS_ENDPOINT=rustfs:9000
# RESTFS_ACCESS_KEY=rustfsadmin
# RESTFS_SECRET_KEY=rustfsadmin
